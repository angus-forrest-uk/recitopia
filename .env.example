# API
RECITOPIA_API_HOST=127.0.0.1
RECITOPIA_API_PORT=8077
RECITOPIA_DB_PATH=data/recitopia.duckdb
RECITOPIA_IMPORT_DIR=data/imports
RECITOPIA_RUST_STORE_MODE=read-write
RECITOPIA_RUST_PIPELINE_CONCURRENCY=
RECITOPIA_TAR_BIN=tar
RECITOPIA_IMAGE_CONVERT_BIN=magick
RECITOPIA_VERBOSE_LOG_DIR=

# LLM provider. Required, no default.
# anthropic | google | openai | openrouter | deepseek
RECITOPIA_LLM_PROVIDER=
RECITOPIA_LLM_API_KEY=

# Used only when RECITOPIA_LLM_API_KEY is unset.
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
OPENAI_API_KEY=
OPENROUTER_API_KEY=
DEEPSEEK_API_KEY=

# Blank uses the provider's own default.
RECITOPIA_LLM_MODEL=
RECITOPIA_LLM_BASE_URL=
RECITOPIA_LLM_MAX_TOKENS=16000
RECITOPIA_LLM_TIMEOUT=90
RECITOPIA_LLM_ATTEMPTS=3

# openrouter only
RECITOPIA_LLM_HTTP_REFERER=
RECITOPIA_LLM_APP_TITLE=

# Mapper scripts
RECITOPIA_LLM_PYTHON=python3
RECITOPIA_LLM_SCRIPT=tools/ml/llm_mapper.py
RECITOPIA_LLM_COOKBOOK_SCRIPT=tools/ml/llm_cookbook_mapper.py

# Whole-cookbook batching
RECITOPIA_LLM_COOKBOOK_MAX_TOKENS=16000
RECITOPIA_LLM_COOKBOOK_PAGES_PER_REQUEST=4
RECITOPIA_LLM_COOKBOOK_PAGE_OVERLAP=1
RECITOPIA_LLM_COOKBOOK_PARALLELISM=4
RECITOPIA_LLM_COOKBOOK_SECTION_CHAR_BUDGET=28000
RECITOPIA_VERBOSE_LLM_LOGS=true

# OCR. Unset RECITOPIA_OCR_PYTHON to run without OCR; imports then fall back
# to a heuristic draft and carry review warnings.
RECITOPIA_OCR_PYTHON=
RECITOPIA_OCR_SCRIPT=tools/ocr/paddle_ocr.py
RECITOPIA_OCR_SERVER_URL=http://127.0.0.1:8078
RECITOPIA_OCR_SERVER_HOST=127.0.0.1
RECITOPIA_OCR_SERVER_PORT=8078
RECITOPIA_OCR_BATCH_PAGE_LIMIT=
RECITOPIA_OCR_PREPARE_PARALLELISM=4
RECITOPIA_OCR_IMAGE_CONVERT_BIN=magick
RECITOPIA_OCR_IMAGE_MAX_DIMENSION=
RECITOPIA_OCR_IMAGE_QUALITY=
RECITOPIA_PADDLE_LANG=en
RECITOPIA_OCR_LOG_LEVEL=INFO

# Release a shared GPU between OCR batches by pausing another unit.
RECITOPIA_OCR_GPU_ACQUIRE_UNIT=
RECITOPIA_OCR_GPU_RELEASE_UNIT=
RECITOPIA_OCR_GPU_RELEASE_DELAY_SECONDS=20
RECITOPIA_OCR_SYSTEMCTL_BIN=systemctl

# Clients
RECITOPIA_API_URL=http://127.0.0.1:8077
RECITOPIA_HELIX_BIN=hx
