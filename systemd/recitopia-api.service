[Unit]
Description=Recitopia API
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=recitopia
Group=recitopia
StateDirectory=recitopia
Environment=RECITOPIA_API_HOST=0.0.0.0
Environment=RECITOPIA_API_PORT=8077
Environment=RECITOPIA_DB_PATH=/var/lib/recitopia/recitopia.duckdb
Environment=RECITOPIA_IMPORT_DIR=/var/lib/recitopia/imports
Environment=RECITOPIA_OCR_SERVER_URL=http://127.0.0.1:8078
Environment=RECITOPIA_LLM_BASE_URL=https://api.llm.com
EnvironmentFile=-/etc/recitopia/llm
ExecStart=/opt/recitopia/bin/recitopia-api
Restart=on-failure
RestartSec=5s

NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
SystemCallFilter=@system-service
SystemCallArchitectures=native
CapabilityBoundingSet=

[Install]
WantedBy=multi-user.target
